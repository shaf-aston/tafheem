# Tafheem: every key here is optional. With none of them the app still runs,
# fully offline. Copy to .env and fill in only what you want.

# Which machine writes the AI explanations: groq, ollama, none.
# Blank picks whichever is reachable.
AI_BACKEND=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5

# Who listens to recitation. Without a key it is heard on this machine instead.
RECITATION_GROQ_API_KEY=
RECITATION_DEEPGRAM_API_KEY=

PORT=8000

# The addresses the browser may call this backend from. The three dev server
# ports are built in; add a public site here when there is one.
# CORS_ORIGINS=["https://your-site.vercel.app"]
