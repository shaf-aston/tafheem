      "dialogue": [
        {
          "speaker": "نور",
          "arabic": "مرحبا، عندي حجز باسم نور",
          "transliteration": "mar7aba, 3andi 7ajez b-ism noor",
          "english": "Hello, I have a reservation under the name Nour."
        },
        {
          "speaker": "الموظف",
          "arabic": "أهلا وسهلا، لحظة تكرم عيونك",
          "transliteration": "ahlan w sahlan, la7Za tkarram 3younak",
          "english": "Welcome, one moment please."
        },
        {
          "speaker": "الموظف",
          "arabic": "ايوا، لاقيت الحجز، غرفة لشخصين صح؟",
          "transliteration": "eewa, la2eet l-7ajez, ghorfe la-shakhSein Sa7?",
          "english": "Yes, found the reservation, a room for two, right?"
        },
        {
          "speaker": "نور",
          "arabic": "ايوا تمام",
          "transliteration": "eewa tamaam",
          "english": "Yes, that's right."
        },
        {
          "speaker": "الموظف",
          "arabic": "قديش رح تبقوا؟",
          "transliteration": "addeesh ra7 teb2o?",
          "english": "How long will you be staying?"
        },
        {
          "speaker": "نور",
          "arabic": "تلات ليالي",
          "transliteration": "tlaat layaali",
          "english": "Three nights."
        },
        {
          "speaker": "الموظف",
          "arabic": "تمام، هاد المفتاح، الغرفة بالطابق التاني",
          "transliteration": "tamaam, haad l-muftaa7, l-ghorfe bel-Taabe2 t-taani",
          "english": "Alright, here's the key, the room is on the second floor."
        },
        {
          "speaker": "نور",
          "arabic": "في فطور مع الحجز؟",
          "transliteration": "fi fToor ma3 l-7ajez?",
          "english": "Is breakfast included with the reservation?"
        },
        {
          "speaker": "الموظف",
          "arabic": "ايه أكيد، من الساعة سبعة لعشرة",
          "transliteration": "eh akiid, mn s-sa3a sab3a la-3ashra",
          "english": "Yes of course, from seven to ten."
        },
        {
          "speaker": "نور",
          "arabic": "شكرا كتير",
          "transliteration": "shukran ktiir",
          "english": "Thanks a lot."
        },
        {
          "speaker": "الموظف",
          "arabic": "عفوا، إقامة سعيدة!",
          "transliteration": "3afwan, i2aama sa3iide!",
          "english": "You're welcome, enjoy your stay!"
        }
