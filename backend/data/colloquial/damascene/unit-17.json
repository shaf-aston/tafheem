          "speaker": "Layla",
          "arabic": "قديش هاد؟",
          "transliteration": "addeesh haad؟",
          "english": "How much is this?"
        },
        {
          "speaker": "Abu Fadi",
          "arabic": "هاد بخمسمية.",
          "transliteration": "haad b-khamsmiyye.",
          "english": "This is for five hundred."
        },
        {
          "speaker": "Layla",
          "arabic": "غالي كتير!",
          "transliteration": "ghaali ktiir!",
          "english": "Too expensive!"
        },
        {
          "speaker": "Abu Fadi",
          "arabic": "طيب، خفف شوي، بأربعمية.",
          "transliteration": "tayyeb, khaffef shway, b-arba3miyye.",
          "english": "Okay, a bit less, four hundred."
