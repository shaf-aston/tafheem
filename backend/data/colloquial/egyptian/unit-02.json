      "dialogue": [
        {
          "speaker": "Karim",
          "arabic": "إزيك يا منى؟",
          "transliteration": "ezzayyek ya Mona?",
          "english": "How are you, Mona?"
        },
        {
          "speaker": "Mona",
          "arabic": "الحمد لله، إزيك إنت يا كريم؟",
          "transliteration": "el-7amdu lillah, ezzayyak enta ya Kareem?",
          "english": "Thank God, how are you, Karim?"
        },
        {
          "speaker": "Karim",
          "arabic": "تمام الحمد لله. العيلة عاملة إيه؟",
          "transliteration": "tamaam el-7amdu lillah. el-3eela 3amla eih?",
          "english": "Fine, thank God. How is the family?"
        },
        {
          "speaker": "Mona",
          "arabic": "كلهم بخير. عندي أخ وأختين.",
          "transliteration": "kollohom bekheer. 3andi akh we okhteen.",
          "english": "They are all well. I have a brother and two sisters."
        },
        {
          "speaker": "Karim",
          "arabic": "وأبوكي وأمك؟",
          "transliteration": "we abooki we ommik?",
          "english": "And your father and mother?"
        },
        {
          "speaker": "Mona",
          "arabic": "أبويا وماما كويسين الحمد لله.",
          "transliteration": "abooya we mama kwayyeseen el-7amdu lillah.",
          "english": "My dad and mum are good, thank God."
        },
        {
          "speaker": "Mona",
          "arabic": "وإنت، متجوز؟",
          "transliteration": "we enta, metgawwez?",
          "english": "And you, are you married?"
        },
        {
          "speaker": "Karim",
          "arabic": "لا، لسه أعزب.",
          "transliteration": "la2, lissa a3zab.",
          "english": "No, I'm still single."
        },
        {
          "speaker": "Karim",
          "arabic": "بس أخويا متجوز وعنده بنت.",
          "transliteration": "bass akhooya metgawwez we 3ando bint.",
          "english": "But my brother is married and has a daughter."
        },
        {
          "speaker": "Mona",
          "arabic": "ما شاء الله! اسمها إيه؟",
          "transliteration": "ma sha2 Allah! esmaha eih?",
          "english": "Ma sha Allah! What's her name?"
        },
        {
          "speaker": "Karim",
          "arabic": "اسمها ليلى.",
          "transliteration": "esmaha Leila.",
          "english": "Her name is Leila."
