        {
          "slot": "good-that-you-called",
          "arabic": "حَلْوَ إِنَّك اتَّصَلْتَ",
          "transliteration": "hallo ennak attasalt"
        },
        {
          "slot": "what-s-new",
          "arabic": "كِيْفَكَ أَنْتَ؟",
          "transliteration": "keefak anta?",
