        },
        {
          "slot": "hi-who-s-this",
          "arabic": "مِنْ هِذَا مِعَك؟",
          "transliteration": "min hadha mi3ak?"
        },
        {
          "slot": "this-is-samer-speaking",
          "arabic": "مِعَاكَ سَامِر",
          "transliteration": "mi3aak Saamer"
