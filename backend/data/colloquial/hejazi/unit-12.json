          "arabic": "مَا في شِبَّاكَة هِنَا",
          "transliteration": "ma fee shibbaka hina"
        },
        {
          "slot": "can-you-call-me-back-in-a-bit",
          "arabic": "تِقْدِر تِتَّصِل عَلَيَّ بَعِد شْوَيَّة؟",
          "transliteration": "tigdar tittasil 3alayya ba3d shwayya?",
          "reply": {
            "arabic": "تَمَام، بَاتَّصِل عَلَيْكَ",
            "transliteration": "tamaam, baattasil 3aleek",
            "english": "Sure, I'll call you."
          }
        }
      ],
      "dialogue": [
        {
          "speaker": "سامر",
          "arabic": "أَلُّو؟",
          "transliteration": "aaloo?",
          "english": "Hello?"
        },
        {
          "speaker": "نور",
          "arabic": "السَّلاَمُ عَلَيْكُمْ، مِعَاكَ نُور",
          "transliteration": "assalamu 3aleekum, mi3aak Noor",
          "english": "Hi Samer, it's Noor."
        },
        {
          "speaker": "سامر",
          "arabic": "وَعَلَيْكُمُ السَّلاَمُ، كِيْفَكَ أَنْتَ يَا نُور؟",
          "transliteration": "wa3aleekum assalam, keefak anta ya Noor?",
          "english": "Hi Noor, how are you?"
        },
        {
          "speaker": "نور",
          "arabic": "تَمَام الْحَمْد لِلّٰهِ، اتَّصَلْتُ عَلَيْكَ قَبَل شْوَيَّة بَس الْخَطّ كَانَ مَشْغُول",
          "transliteration": "tamaam il7amdella, attasalt 3aleek 2abel shwayya bas il-khatt kaan mashghool",
          "english": "All good. I called you a bit ago but the line was busy."
        },
        {
          "speaker": "سامر",
          "arabic": "إِيْ، كُنْتُ أَتَكَلَّمُ مَعَ أَخِي. آسِف إِنِّي مَا قِدِرْتُ أَرُدّ عَلَيْكَ",
          "transliteration": "ee, kuntu atkallam ma3a akhi. aasif inni ma 2dirt arudd 3aleek",
          "english": "Yeah, I was talking with my brother. Sorry I couldn't answer."
        },
        {
          "speaker": "نور",
          "arabic": "الْحَمْد لِلّٰهِ عَلَى كُل حَال. أَبْغَى أَتَكَلَّمَ مَعَاكَ عَنْ الْمَوْعِد",
          "transliteration": "il7amdella 3ala kull 7al. abgha atkallam ma3aak 3an il-maw3id",
          "english": "It's all good. I want to talk about the appointment."
        },
        {
          "speaker": "سامر",
          "arabic": "تَفَضَّل، بَس ثَانِيَّة، رَصِيدِي بِيَنْتَهِي",
          "transliteration": "tafaddal, bas thaniyya, rasiidi biyntahi",
          "english": "Go ahead, just a second, my credit is about to run out."
        },
        {
          "speaker": "نور",
          "arabic": "طَيِّب خَلِّينِي أَتَكَلَّمُ بِسُرْعَة قَبْل مَا يَنْقَطِعُ الْخَطّ",
          "transliteration": "tayyib khallini atkallam bisur3a 2abel ma yingati3 il-khatt",
          "english": "Okay let me talk fast before the call drops."
        },
        {
          "speaker": "سامر",
          "arabic": "لاَ لاَ، خَلاَص، انْقَطَعَ! تِقْدِرِي تِتَّصِلِي عَلَيَّ بَعِد شْوَيَّة؟",
          "transliteration": "la la, khalaas, ingata3! tigdari titasili 3alayya ba3d shwayya?",
          "english": "No no, that's it, it got cut off! Can you call me back?"
        },
        {
          "speaker": "نور",
          "arabic": "تَمَام، حَلْوَ إِنَّك اتَّصَلْتَ أَصْلاً. بَاتَّصِل عَلَيْكَ",
          "transliteration": "tamaam, hallo ennak attasalt aslan. baattasil 3aleek",
          "english": "Okay, good that you called. I'll call you back."
        },
        {
          "speaker": "سامر",
          "arabic": "الْحَمْد لِلّٰهِ، بَاسْتِنَى",
          "transliteration": "il7amdella, bastina",
          "english": "Thank God, I'll wait."
        }
      ],
