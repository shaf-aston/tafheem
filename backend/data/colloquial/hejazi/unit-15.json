      "dialogue": [
        {
          "speaker": "نور",
          "arabic": "أهلا، عندي حجز باسم نور",
          "transliteration": "ahlan, 3andi 7ajz b-ism noor",
          "english": "Hello, I have a reservation under the name Nour."
        },
        {
          "speaker": "الموظف",
          "arabic": "أهلا وسهلا، لحظة من فضلك",
          "transliteration": "ahlan wa sahlan, la7Za min faDlak",
          "english": "Welcome, one moment please."
        },
        {
          "speaker": "الموظف",
          "arabic": "إي لقيت الحجز، غرفة لشخصين صح؟",
          "transliteration": "ee lageet l-7ajz, ghorfa la-shakhSayn Sa7?",
          "english": "Yes, I found the reservation, a room for two, right?"
        },
        {
          "speaker": "نور",
          "arabic": "إي صح",
          "transliteration": "ee Sa7",
          "english": "Yes, that's right."
        },
        {
          "speaker": "الموظف",
          "arabic": "كم ليلة بتقعد؟",
          "transliteration": "kam layla bitgu3ud?",
          "english": "How many nights will you stay?"
        },
        {
          "speaker": "نور",
          "arabic": "ثلاث ليالي",
          "transliteration": "thlaath layaali",
          "english": "Three nights."
        },
        {
          "speaker": "الموظف",
          "arabic": "تمام، هاد المفتاح، غرفتك في الطابق الثاني",
          "transliteration": "tamam, haad l-muftaa7, ghorftik fi T-Taabe2 th-thanee",
          "english": "Alright, here's the key, your room is on the second floor."
        },
        {
          "speaker": "نور",
          "arabic": "في إفطار مع الحجز؟",
          "transliteration": "fi iftaar ma3 l-7ajz?",
          "english": "Is breakfast included with the reservation?"
        },
        {
          "speaker": "الموظف",
          "arabic": "إي تمام، من السابعة للعاشرة",
          "transliteration": "ee tamam, min s-sab3a ll-3aashira",
          "english": "Yes of course, from seven to ten."
        },
        {
          "speaker": "نور",
          "arabic": "شكراً كتير",
          "transliteration": "shukran ktiir",
          "english": "Thanks a lot."
        },
        {
          "speaker": "الموظف",
          "arabic": "على راحتك، إقامة سعيدة",
          "transliteration": "3ala raa7tak, i2aama sa3iida",
          "english": "You're welcome, enjoy your stay."
        }
      ],
