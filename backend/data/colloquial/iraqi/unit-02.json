          "speaker": "Sameer",
          "arabic": "عندچ عايلة كبيرة؟",
          "transliteration": "3indich 3aayle kbeera؟",
          "english": "Do you have a big family?"
        },
        {
          "speaker": "Dima",
          "arabic": "إي، عندي أخ وأختين. وإنت؟",
          "transliteration": "ee, 3indi akh w ukhtayn. w inta؟",
          "english": "Yes, I have a brother and two sisters. And you?"
        },
        {
          "speaker": "Sameer",
          "arabic": "آني عندي مرتي وابني بس.",
          "transliteration": "aani 3indi marti w ibni bass.",
          "english": "I just have my wife and my son."
        },
        {
          "speaker": "Dima",
          "arabic": "زين، آني جوعانة هواية، تريد تاكل شي؟",
          "transliteration": "zayn, aani juu3aana hwaaya, treed taakul shi؟",
          "english": "Okay, I'm very hungry, do you want to eat something?"
        },
        {
          "speaker": "Sameer",
          "arabic": "إي، أحب الفلافل.",
          "transliteration": "ee, a7ibb il-falaafil.",
          "english": "Yes, I like falafel."
        },
        {
          "speaker": "Dima",
          "arabic": "وشنو تريد تشرب؟",
          "transliteration": "w shinu treed tishrab؟",
          "english": "And what do you want to drink?"
        },
        {
          "speaker": "Sameer",
          "arabic": "أريد چاي.",
          "transliteration": "areed chaay.",
          "english": "I want tea."
        },
        {
          "speaker": "Dima",
          "arabic": "بالعافية!",
          "transliteration": "bil-3aafya!",
          "english": "Enjoy the meal!"
        },
        {
          "speaker": "Sameer",
          "arabic": "الله يعافيچ.",
          "transliteration": "allah y3aafiich.",
          "english": "Thank you."
        },
        {
          "speaker": "Sameer",
          "arabic": "الحساب لو سمحت.",
          "transliteration": "il-7isaab law sama7t.",
          "english": "The bill, please."
        },
        {
          "speaker": "Dima",
          "arabic": "تمام، شكد الحساب؟",
          "transliteration": "tamaam, shgadd il-7isaab؟",
          "english": "Okay, how much is the bill?"
        },
        {
          "speaker": "Sameer",
          "arabic": "ما أدري، خل نسأل.",
          "transliteration": "ma adri, khalli nis2al.",
          "english": "I don't know, let's ask."
        }
      ]
