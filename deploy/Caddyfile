# Caddy answers the internet on 443: /api goes to the backend (which only
# listens on this machine), everything else is the built website in ~/site.
# Every request is logged with the visitor's
# real address (Vercel's x-vercel-forwarded-for header); read it with usage.sh.
#
# Two backend copies run at once (tafheem@8000, tafheem@8001). sync.sh
# restarts them one at a time; the health check below stops sending requests
# to whichever one is mid-restart, so a deploy never drops a request.
132-145-17-56.sslip.io {
	log {
		output file /var/log/caddy/access.log {
			roll_size 10mb
			roll_keep 10
		}
		# Never kept: who someone is (the profile and device headers say it with no password, so a
		# copy of them is the account), the recording studio's key, and anything typed into a search.
		# The visitor's address stays: usage.sh and security-report.sh need it, and it rolls away.
		format filter {
			request>headers>X-Vercel-Proxy-Signature delete
			request>headers>X-Vercel-Proxied-For delete
			request>headers>X-Tafheem-Profile delete
			request>headers>X-Tafheem-Guest delete
			request>headers>X-Recorder-Key delete
			request>uri query {
				delete q
				delete text
				delete sentence
				delete word
			}
		}
	}
	header -Server
	handle /api/* {
		# The largest thing anyone sends is a recitation (listening_max_mb, 12 MiB, routers/listen.py). Past this the
		# request is refused here, before the backend spools it to disk.
		request_body {
			max_size 14MiB
		}
		reverse_proxy 127.0.0.1:8000 127.0.0.1:8001 {
			health_uri /api/health
			health_interval 5s
			health_timeout 3s
			lb_policy round_robin
			# The active health check above only samples every 5s, too slow to
			# catch an instance the instant it stops for a restart. This makes
			# a request that hits the down one retry the other immediately,
			# instead of waiting on the next health check.
			lb_try_duration 5s
			lb_try_interval 250ms
		}
	}
	# The website's copy here gets the same headers vercel.json gives the live one. The backend
	# sets its own for /api (services/core/headers.py).
	handle {
		header {
			Strict-Transport-Security "max-age=31536000"
			X-Content-Type-Options nosniff
			X-Frame-Options DENY
			Referrer-Policy strict-origin-when-cross-origin
			Permissions-Policy "microphone=(self), camera=(), geolocation=(), payment=(), usb=()"
			Cross-Origin-Opener-Policy "same-origin"
		}
		root * /home/ubuntu/site
		try_files {path} {path}.html {path}/index.html
		file_server
	}
	encode zstd gzip
}
