# The backend, one instance per port, kept running and restarted if it dies or
# the machine reboots. Two instances (tafheem@8000, tafheem@8001) run at once
# so sync.sh can restart them one at a time behind Caddy's health check,
# instead of one shared unit that drops every request while it reloads.
# Install: sudo cp deploy/tafheem@.service /etc/systemd/system/
[Unit]
Description=Tafheem backend (port %i)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/tafheem
# The venv first; /usr/bin for ffmpeg, which the recording studio runs (services/speech_recordings.py).
Environment=PATH=/home/ubuntu/tafheem/venv/bin:/usr/bin:/bin
# No access log here: uvicorn's would put every query string (?q=, ?text=, typed sentences) into
# journald. Caddy's access log has the same requests with those parameters filtered out (deploy/Caddyfile),
# and deploy/usage.sh counts from it; refusals are in logs/security.jsonl (services/core/audit.py).
ExecStart=/home/ubuntu/tafheem/venv/bin/uvicorn backend.main:app --host 127.0.0.1 --port %i --no-access-log
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
