{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.stryker.config.js",
    "related": true
  },
  "mutate": [
    "src/lib/grow/alifLam.js",
    "src/lib/grow/lesson.js",
    "src/lib/grow/wordForms.js",
    "src/lib/grow/basicsSkills.js",
    "src/lib/learner/learnerLevel.js",
    "src/lib/grow/useLessonSession.js",
    "src/lib/learner/record.js"
  ],
  "ignorePatterns": [
    "dist",
    "reports",
    "*.png"
  ],
  "coverageAnalysis": "perTest",
  "concurrency": 2,
  "reporters": [
    "clear-text",
    "progress",
    "json",
    "html"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation/mutation.html"
  },
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 75
  },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true
}
