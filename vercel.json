{
  "framework": "vite",
  "installCommand": "cd frontend && npm ci",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/:tab(home|nahw|sarf|quran|daleel|hadith|dict|dictionary|mem|memorise|similar|grow|quiz|timelines|dawah|colloq|colloquial|map|kit|iraab|tarkeeb)/:place*",
      "destination": "/app.html"
    },
    {
      "source": "/api/:path*",
      "destination": "https://132-145-17-56.sslip.io/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "claude/*": false
    }
  },
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- frontend vercel.json backend/data/hadith/chain.json",
  "redirects": [
    {
      "source": "/app/:path+",
      "destination": "/:path+",
      "permanent": true
    }
  ]
}
